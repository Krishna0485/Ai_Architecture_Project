# Copy to .env (git-ignored) and adjust. Every variable maps to regintel.config.Settings.
# Values here are placeholders - never commit real secrets.

# --- Runtime ------------------------------------------------------------------------------
REGINTEL_ENV=dev                         # dev | test | staging | prod

# --- Retrieval ----------------------------------------------------------------------------
REGINTEL_EMBEDDER=hashing                # hashing (offline) | bge (needs `uv sync --extra ml`)
REGINTEL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
REGINTEL_EMBEDDING_DIM=1024              # must match the model when EMBEDDER=bge (384 for bge-small)
REGINTEL_VECTOR_STORE=memory             # memory | qdrant
REGINTEL_QDRANT_URL=http://qdrant:6333
REGINTEL_KEYWORD_STORE=bm25              # bm25 (in-process) | opensearch
REGINTEL_OPENSEARCH_URL=http://opensearch:9200
REGINTEL_RERANKER=lexical                # lexical | cross-encoder
REGINTEL_RETRIEVAL_MODE=hybrid           # vector | bm25 | hybrid
REGINTEL_USE_RERANK=true
REGINTEL_USE_QUERY_REWRITE=false
REGINTEL_TOP_K=20
REGINTEL_RERANK_TOP_N=5
REGINTEL_MIN_SCORE=0.40                  # abstention threshold (IDF-weighted query coverage)

# --- LLM gateway --------------------------------------------------------------------------
REGINTEL_LLM_PROVIDER=heuristic          # heuristic (offline) | openai_compatible (LiteLLM proxy)
REGINTEL_GATEWAY_URL=http://gateway:4000
REGINTEL_GATEWAY_API_KEY=change-me       # LiteLLM master/virtual key
REGINTEL_MODEL_FAST=fast                 # LiteLLM alias -> small quantised local model
REGINTEL_MODEL_SMART=smart               # LiteLLM alias -> larger model (local or hosted)
REGINTEL_ROUTING_ENABLED=true
REGINTEL_REQUEST_TOKEN_BUDGET=6000
REGINTEL_TENANT_DAILY_TOKEN_BUDGET=2000000
REGINTEL_CONTEXT_TOKEN_BUDGET=1800
# Provider keys are read by the LiteLLM container only (never by RegIntel):
ANTHROPIC_API_KEY=
LITELLM_MASTER_KEY=change-me

# --- Cache --------------------------------------------------------------------------------
REGINTEL_CACHE_BACKEND=memory            # none | memory | redis
REGINTEL_REDIS_URL=redis://redis:6379/0
REGINTEL_CACHE_SIMILARITY_THRESHOLD=0.93

# --- Guardrails / agents ------------------------------------------------------------------
REGINTEL_PII_BACKEND=regex               # regex | presidio (needs `uv sync --extra guardrails`)
REGINTEL_INJECTION_THRESHOLD=0.5
REGINTEL_AGENTS_ENABLED=true             # kill switch for agent workflows
REGINTEL_CHECKPOINTER=memory             # memory | postgres
REGINTEL_POSTGRES_DSN=postgresql://postgres:devonly@postgres:5432/regintel
REGINTEL_CHECK_EXECUTOR=background       # inline | background | queue (worker)

# --- Security / tenancy -------------------------------------------------------------------
# JSON map api_key -> grant. Generate keys with: python -c "import secrets;print(secrets.token_urlsafe(32))"
REGINTEL_API_KEYS={"replace-with-random-key":{"tenant_id":"acme","groups":["compliance","admin"],"actor":"acme-app"}}
REGINTEL_MCP_DEFAULT_API_KEY=            # identity for the stdio MCP transport
REGINTEL_AUDIT_BACKEND=jsonl             # jsonl | memory | postgres

# --- Observability ------------------------------------------------------------------------
REGINTEL_OTEL_ENABLED=false
REGINTEL_OTEL_ENDPOINT=http://otel-collector:4318/v1/traces
REGINTEL_LANGFUSE_HOST=http://langfuse:3000
REGINTEL_LANGFUSE_PUBLIC_KEY=
REGINTEL_LANGFUSE_SECRET_KEY=
